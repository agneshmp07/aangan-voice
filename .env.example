# ---- Mode ----------------------------------------------------------------
# 1 = no external accounts needed; Telegram/email/Calendar/Sheets write to the local outbox.
MOCK_MODE=1
DB_PATH=data/aangan.db
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Required on Vercel (its disk is not persistent). Leave blank locally to use SQLite.
DATABASE_URL=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET=
RUN_SCHEDULER=1
PUBLIC_BASE_URL=https://your-tunnel-or-host.example

# Shared secret the voice platform sends as "X-Aangan-Secret: <value>" or "Authorization: Bearer <value>"
TOOL_SECRET=change-me

# ---- Guardrails ------------------------------------------------------------
# Worst case per tool call = 0.5s body read + TOOL_TIMEOUT_S + 0.5s fallback. Keep <= 2.5 for < 4s.
TOOL_TIMEOUT_S=2.5
CALLBACK_DELAY_MIN=10
CALLBACK_DEDUPE_HOURS=24
CLAIM_TIMEOUT_MIN=30

# ---- Costs (INR). Leave blank if unknown: the dashboard then says "unknown", never 0 ----
# VaniAgent metered plan: ₹4.5/min all-in (vaniagent.com pricing, read 2026-10-10). Use your invoice if different.
PLATFORM_COST_PER_MIN_INR=4.5
# Only if telephony (the phone number / minutes) is billed separately from Vaani
TELEPHONY_COST_PER_MIN_INR=
# The tool's own running cost per month: hosting + number rental + anything else
MONTHLY_FIXED_COST_INR=

# ---- Handoff: Telegram (primary) -----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNERS_CHAT_ID=
TELEGRAM_HEAD_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ---- Handoff: email (automatic fallback) ---------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
DESIGNERS_EMAIL=
HEAD_EMAIL=
# Names used for the email "claim" links
DESIGNERS=Designer A,Designer B,Designer C

# ---- Google (Calendar booking + Sheets mirror) ---------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=

# ---- Callbacks -------------------------------------------------------------
# human = task to the front desk via Telegram/email; vaani_outbound = POST to an outbound-call URL
CALLBACK_MODE=human
VAANI_OUTBOUND_URL=
VAANI_API_KEY=

# ---- VaniAgent webhook ----------------------------------------------------
# Copy from VaniAgent Dashboard → Settings → Webhooks. Verifies X-Vaniagent-Signature.
VAANI_WEBHOOK_SECRET=
VAANI_API_BASE=https://api.vaniagent.com/api/developer/v1
# VaniAgent → Developer API → Create API Key (sent as X-API-Key). Also powers the browser "talk now" button.
# VAANI_API_KEY is above. VAANI_AGENT_ID: the agent's ID (Agents list, under the name).
VAANI_AGENT_ID=
WIDGET_MAX_SESSION_MINUTES=5
WIDGET_MAX_DAILY_SESSIONS=30
WIDGET_SESSIONS_PER_VISITOR_HOUR=3
